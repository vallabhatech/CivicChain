# Copy to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# SQLite is the default for a quick local demo.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Required for deterministic vote verification across restarts/deployments.
BLOCKCHAIN_GENESIS_KEY=replace-with-a-random-secret

# Optional SMS provider. Leave SMS_API_KEY empty to disable external SMS.
SMS_API_URL=https://smslogin.co/v3/api.php?
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=CODEBK

SECURE_SSL_REDIRECT=False
